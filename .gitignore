# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# --- IDE / OS ---
.vscode/
.idea/
Thumbs.db
desktop.ini

# --- Результати проєкту ---
# Результати прогонів не комітимо, крім .gitkeep
out/images/*
out/stages/*
out/metrics/*
!out/**/.gitkeep

# --- Дані ---
# Сирі зображення вибірки тримаємо локально; у репозиторії маніфест і посилання
data/raw/*
!data/raw/.gitkeep
data/reference/*
!data/reference/.gitkeep

# --- Звіти (бінарні файли) ---
docs/report/*.pdf
docs/report/*.docx
